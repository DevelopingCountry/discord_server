# docker-compose.prod.yml 용 환경변수 예시 파일.
# 실제 값을 채운 뒤 이 파일을 ".env"로 복사해서 VM에 두세요 (.env는 .gitignore에 이미 포함되어
# 커밋되지 않습니다). docker compose가 같은 디렉터리의 .env를 자동으로 읽어 변수를 치환합니다.

# MySQL
DB_USERNAME=discord_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# JWT (application.yml 기본값과 다른, 배포 전용 시크릿을 새로 생성해서 넣으세요)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 프론트엔드 배포 도메인 (Caddyfile의 discord-app-harmonica.duckdns.org 자리와 동일한 값이어야 함)
CORS_ALLOWED_ORIGIN=https://discord-app-harmonica.duckdns.org

# 카카오 개발자 콘솔에 등록한 값과 정확히 일치해야 합니다
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://discord-app-harmonica.duckdns.org/auth/kakao
# 카카오 콘솔 "카카오 로그인 > 보안"에서 Client Secret이 "사용함(필수)"인 경우에만 채우기.
# "사용안함"이면 비워두면 됩니다.
KAKAO_CLIENT_SECRET=

# TURN 서버(coturn) — 음성/영상 채팅이 서로 다른 네트워크(NAT) 간에도 연결되게 해주는
# 미디어 릴레이. TURN_USERNAME/PASSWORD는 임의로 정해서 채우면 되고(카카오처럼 외부에
# 등록하는 값이 아님), 프론트엔드의 VITE_TURN_USERNAME/VITE_TURN_CREDENTIAL과 반드시
# 동일한 값이어야 합니다. TURN_EXTERNAL_IP는 이 VM의 공인 IP(예: 129.225.201.67).
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=